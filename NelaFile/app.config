<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="NelaFile.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
    </sectionGroup>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="NelaFile.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
    </sectionGroup>
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <appSettings>
    <add key="server" value="localhost"/>
    <add key="port" value="5432"/>
    <add key="username" value="myusername"/>
    <add key="password" value="mypass"/>
    <add key="database" value="mydb"/>
    <add key="OutputFolder" value="C:\aa"/>
    <add key="VyberZakazaek" value="         SELECT x.VZ_BatchNo,x.ZO_BatchNo,x.Order_no,x.release_no,x.sequence_no,x.part_no, MAX((SELECT distinct ip.description FROM IFSAPP.inventory_part ip WHERE ip.part_no = x.part_no AND ip.contract = 'AD')) as part_desc, MAX(x.customer_order) as customer_order,MAX(x.customer_line_no) as customer_line_no, MAX(x.customer_rel_no) as customer_rel_no,MAX(x.customer_line_item_no) as customer_line_item_no, SUM(x.sub_pack_amount) as CelkemKs,MAX((SELECT ci.name FROM IFSAPP.customer_info ci  WHERE ci.customer_id = x.customer_no)) as Zakaznik  FROM  ( SELECT a.order_no || '-' || a.release_no ||'-' || a.sequence_no as VZ_BatchNo,a.customer_order || '-' || a.customer_line_no ||'-' || a.customer_rel_no as ZO_BatchNo, a.order_no,a.release_no,a.sequence_no,a.customer_order,a.customer_line_no,a.customer_rel_no,a.customer_line_item_no,a.part_no,a.sub_pack_amount,a.customer_no  FROM IFSAPP.C_BARCODE_SHPORD_TAB a   WHERE substr(a.part_no,1,5)  IN ('NA601','NA611','NA620','NA622','NA654','NA650','NA720','NA750')  AND  to_number(to_char(a.rowversion,'YYYY')) &gt;= 2014 and a.barcode_processed = 'FALSE' and a.customer_order like 'V%') x  GROUP by x.VZ_BatchNo,x.ZO_BatchNo,x.Order_no,x.release_no,x.sequence_no,x.part_no  HAVING  to_number(substr(substr(x.ZO_BatchNo,2,instr(x.ZO_BatchNo,'-',1,1)-2),1,2)) &gt; 11   ORDER BY to_number(substr(x.ZO_BatchNo,2,instr(x.ZO_BatchNo,'-',1,1)-2)) DESC              "/>
    <add key="ClientSettingsProvider.ServiceUri" value=""/>
  </appSettings>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri=""/>
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400"/>
      </providers>
    </roleManager>
  </system.web>
  <userSettings>
    <NelaFile.Properties.Settings>
      <setting name="OutputFolder" serializeAs="String">
        <value>c:\aa</value>
      </setting>
      <setting name="VyberZakazek" serializeAs="String">
        <value>SELECT x.VZ_BatchNo,x.ZO_BatchNo,x.Order_no,x.release_no,x.sequence_no,x.part_no,
MAX((SELECT distinct ip.description FROM IFSAPP.inventory_part ip WHERE ip.part_no = x.part_no AND ip.contract = 'AD')) as part_desc,
MAX(x.customer_order) as customer_order,MAX(x.customer_line_no) as customer_line_no,
MAX(x.customer_rel_no) as customer_rel_no,MAX(x.customer_line_item_no) as customer_line_item_no,
SUM(x.sub_pack_amount) as CelkemKs,MAX((SELECT ci.name FROM IFSAPP.customer_info ci 
WHERE ci.customer_id = x.customer_no)) as Zakaznik 
FROM 
(
SELECT a.order_no || '-' || a.release_no ||'-' || a.sequence_no as VZ_BatchNo,a.customer_order || '-' || a.customer_line_no ||'-' || a.customer_rel_no as ZO_BatchNo,
a.order_no,a.release_no,a.sequence_no,a.customer_order,a.customer_line_no,a.customer_rel_no,a.customer_line_item_no,a.part_no,a.sub_pack_amount,a.customer_no 
FROM IFSAPP.C_BARCODE_SHPORD_TAB a  
WHERE substr(a.part_no,1,5) 
IN ('NA601','NA611','NA620','NA622','NA654','NA650','NA720','NA750') 
AND  to_number(to_char(a.rowversion,'YYYY')) &gt;= 2014 and a.barcode_processed = 'FALSE' and a.customer_order like 'V%') x 
GROUP by x.VZ_BatchNo,x.ZO_BatchNo,x.Order_no,x.release_no,x.sequence_no,x.part_no 
HAVING  to_number(substr(substr(x.ZO_BatchNo,2,instr(x.ZO_BatchNo,'-',1,1)-2),1,2)) &gt; 11  
ORDER BY to_number(substr(x.ZO_BatchNo,2,instr(x.ZO_BatchNo,'-',1,1)-2)) DESC</value>
      </setting>
      <setting name="Info" serializeAs="String">
        <value>Výběr nálepek:
do data gridu:
SELECT (c.doc_class || '-' || c.doc_no || '-' ||c.doc_rev || '.' || c.format_size) as FILE_NAME,c.doc_class FROM IFSAPP.DOC_REFERENCE_OBJECT a, IFSAPP.DOC_STRUCTURE b,IFSAPP.DOC_ISSUE_REFERENCE c WHERE a.doc_class = b.doc_class AND a.doc_no = b.doc_no AND a.doc_rev = b.doc_rev AND b.sub_doc_class = c.doc_class AND b.sub_doc_no  = c.doc_no AND b.sub_doc_rev = c.doc_rev AND a.lu_name = 'CustomerOrderLine' AND a.key_value LIKE  'V92002^6^1^%'
do receptury:
SELECT distinct file_name 
FROM IFSAPP.c_labels_ad a 
WHERE a.order_no = 'V92002' AND  a.line_no = '6' AND  a.release_no = '1' AND  a.line_item_no = '4' AND doc_class LIKE '%KTN%' ORDER BY a.file_name

Nové:


</value>
      </setting>
    </NelaFile.Properties.Settings>
  </userSettings>
  <applicationSettings>
    <NelaFile.Properties.Settings>
      <setting name="SMTP_Server" serializeAs="String">
        <value/>
      </setting>
    </NelaFile.Properties.Settings>
  </applicationSettings>

</configuration>
